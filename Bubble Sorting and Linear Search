#include <stdio.h>
void main() {
     int arr[100],n,i,j,temp,ele;
     printf("Enter no of elements: ");
     scanf("%d",&n);
     printf("Enter elements: ");
     for(i=0;i<n;i++){
        scanf("%d",&arr[i]);
     } 
     for(i=0;i<n-1;i++){
        for(j=0;j<n-1-i;j++){
            if(arr[j]>arr[j+1]){
                temp=arr[j];
                arr[j]=arr[j+1];
                arr[j+1]=temp;
            }
        }
     }
     printf("Sorted Array:");
     for(i=0;i<n;i++){
        printf("%d ",arr[i]);
     }
printf("\nEnter elemet to find: ");
scanf("%d",&ele);
for(i=0;i<n;i++){
    if(arr[i]==ele){
        printf("Element Found at %d",i+1);
        return;
    }
}
printf("Not Found\n");
}
